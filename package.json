{
  "name": "bind",
  "version": "0.1.0",
  "description": "Business agent deployment, authority, and connectivity layer",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit/",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "playwright test tests/e2e/",
    "build": "tsc -p tsconfig.build.json",
    "build:vercel": "tsc -p tsconfig.build.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "node dist/db/migrate.js",
    "db:migrate:dev": "tsx src/db/migrate.ts",
    "map:functions": "tsx scripts/map-functions.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@heroicons/vue": "^2.2.0",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "cors": "^2.8.5",
    "deepagents": "^1.15.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "langsmith": "^0.9.0",
    "parallel-web": "^1.3.5",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "viem": "^2.21.57",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "braces": "npm:@bleedingdev/braces@^3.0.4"
  }
}
