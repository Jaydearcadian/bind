# Local-only development defaults. Never use these as testnet/mainnet configuration.
NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://bind_local:bind_local_only@127.0.0.1:5432/bind_local
SETTLEMENT_MODE=local
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
SUPPLIER_ADAPTER_MODE=simulated
# Generate a local secret with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-local-random-secret
