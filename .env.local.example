# Local-only development defaults. Never use these as testnet/mainnet configuration.
NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://bind_local:bind_local_only@127.0.0.1:5432/bind_local
SETTLEMENT_MODE=local
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
SUPPLIER_ADAPTER_MODE=simulated
# Generate a local secret with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-local-random-secret

# Nebius Token Factory (Active 2026 models: nousresearch/Hermes-4-405B or nvidia/Nemotron-3-Nano-30B-A3B)
# NEBIUS_API_KEY=your_nebius_token_factory_key
# NEBIUS_MODEL=nousresearch/Hermes-4-405B

# Live Market Benchmark Adapters (Parallel primary, Tavily secondary)
# PARALLEL_API_KEY=your_parallel_api_key
# TAVILY_API_KEY=your_tavily_api_key

# LangSmith Verifiable Trace Evidence
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=bind-tameion-arc

# Circle Agent Stack & Arc Canteen RPC on Arc L1
# ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/<ARC_RPC_TOKEN>
# ARC_CHAIN_ID=5042002
# BIND_SETTLEMENT_ADDRESS=0x...
# The signer private key stays server-side and must never be committed.
# ARC_SIGNER_PRIVATE_KEY=0x...
# BIND_SETTLEMENT_DEPLOY_BLOCK=0
# CIRCLE_AGENT_WALLET_ADDRESS=0xA4D196C26F07bcd68FA76a0f1bECd2536C4ae9C2
# ENABLE_LIVE_CIRCLE_CLI=true

# Browser origins allowed to call the API (comma-separated). Unset: no CORS headers are sent.
# BIND_CORS_ORIGINS=https://ops.example.test,http://127.0.0.1:5173
# Optional owner token for the demo workspace (ws-kitchen-main). Format: bnd_ + 43 base64url characters.
# Generate one with: node -e "console.log('bnd_' + require('crypto').randomBytes(32).toString('base64url'))"
# BIND_DEMO_OWNER_TOKEN=

# Webhook signing (ADR 0022). No defaults in source. Each is at least 32 characters when set; an empty value counts as unset.
# BIND_MASTER_SECRET derives each workspace's webhook signing secret. Unset: the webhook routes and the owner's
# webhook-secret routes answer 503 and process nothing (fail closed). Generate with: openssl rand -base64 48
# BIND_MASTER_SECRET=
# BIND_WEBHOOK_SECRET is the shared secret for standard (non-surface) webhooks, sent as an HMAC in x-bind-signature.
# BIND_WEBHOOK_SECRET=

# Connector credential encryption (ADR 0024). Each is base64 of exactly 32 bytes, generated with: openssl rand -base64 32
# Unset: the credential store is disabled and its routes answer 503. Keep the key outside the database.
# BIND_CREDENTIAL_KEY=
# During a rotation, set BIND_CREDENTIAL_KEY_PREVIOUS to the old key (decrypt only), run npm run credentials:rotate-key,
# then remove it.
# BIND_CREDENTIAL_KEY_PREVIOUS=

# Background worker (ADR 0029). Set to false to turn it off.
# BIND_WORKER_ENABLED=true
# Restock sweep (ADR 0030). OFF unless set to true: it starts replenishments, and an order inside policy limits is
# placed without a human approval.
# BIND_RESTOCK_SWEEP=true

# Logs (ADR 0032): debug, info, warn or error. Unset means info.
# LOG_LEVEL=info
# Metrics (ADR 0032): GET /metrics answers only with this bearer token (at least 32 characters). Unset: 404.
# It is not a workspace token. Generate with: openssl rand -base64 32
# BIND_METRICS_TOKEN=
# Client address behind a proxy (ADR 0033): the number of proxy hops that add to X-Forwarded-For. 0 (default) uses the socket address.
# BIND_TRUST_PROXY=0
# Rate limits (ADR 0033). Unset: on (off in NODE_ENV=test). "off" is for local development only.
# BIND_RATE_LIMITS=off
